{
  "name": "@docs-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e ../../.env --",
    "dev": "pnpm with-env tsx watch src/index.ts",
    "worker": "pnpm with-env tsx watch src/worker.ts",
    "runner:dev": "pnpm with-env tsx src/runner-dev.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "pnpm with-env prisma generate",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:backfill-sizes": "pnpm with-env tsx src/scripts/backfill-document-sizes.ts",
    "db:deploy": "pnpm with-env prisma migrate deploy",
    "db:studio": "pnpm with-env prisma studio",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@anvia/client": "1.3.1",
    "@anvia/core": "1.8.0",
    "@anvia/memory-prisma": "1.2.2",
    "@anvia/openai": "1.2.0",
    "@anvia/qdrant": "1.1.4",
    "@anvia/server": "1.2.1",
    "@anvia/transformers": "1.1.5",
    "@docs-agent/agent": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "1.7.9",
    "bullmq": "^5.81.2",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "ioredis": "^5.11.1",
    "undici": "7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3"
  }
}
